Thumbs.db

# 切片产物（输出在外部 out/ 目录，如 D:/fbx_convert/out_abc_pick）
# 这里只列规则：工具运行时不应当用源码目录当产物输出地，
# 真有产物误落到这里请清理掉
/out_*/

